# ============================================================
# Vera Voice Agent - Environment Configuration
# Copy this file to ".env" and fill in your keys. NEVER commit .env!
# ============================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Groq (STT: Whisper Large v3 Turbo, LLM: Llama 3.3 70B)
# Get your FREE key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Cartesia Sonic TTS (Primary Speech Synthesis)
# Get your FREE key at: https://play.cartesia.ai
CARTESIA_API_KEY=your_cartesia_api_key_here
# Recommended Sonic Voice ID (e.g., British / American helpful customer support voice)
CARTESIA_VOICE_ID=79a125e8-cd45-4c13-8a67-188112f4dd22
CARTESIA_MODEL=sonic-2

# Daily.co WebRTC Transport (OPTIONAL - the browser WS audio pipeline works without it)
DAILY_API_KEY=
DAILY_SAMPLE_ROOM_URL=

# Fallback Settings (local synthetic PCM when Cartesia hits rate limits - free)
ENABLE_TTS_FALLBACK=true
TTS_FALLBACK_PROVIDER=kokoro

# Plivo Telephony (Optional Stretch - not needed for browser demo)
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=


